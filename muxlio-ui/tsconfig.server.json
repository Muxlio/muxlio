{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "noEmitOnError": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "src/server.ts"
  ]
}
